{
  "name": "gbcontinuity-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "影视场景连戏与道具接续核对台 - 纯前端 SPA（Vue 3 + TypeScript + Element Plus + Vite + Pinia + Vue Router + Dexie）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 22829",
    "typecheck": "vue-tsc --noEmit",
    "test:chain": "esbuild test/versionChain.test.ts --bundle --platform=node --format=esm --outfile=test/run.mjs --log-level=warning && node test/run.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
